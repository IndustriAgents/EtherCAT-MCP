# Example settings for ethercat-mcp. `ethercat-mcp --help` lists them all.
#
# Either pass a copy with --env-file PATH (any setting), or copy it to
# ethercat-python/.env, the only .env the server reads by itself (from a source
# checkout; never the working directory or a parent, none for an installed
# package). That implicit .env may only set ETHERCAT_* and SLAVE_MAP_FILE, and
# never the safety settings: ETHERCAT_WRITES_ENABLED,
# ETHERCAT_STATE_CHANGE_ENABLED, ETHERCAT_PD_WATCHDOG_MS and
# ETHERCAT_EXPECTED_WKC are ignored there with a warning, in any letter case.
# Set those in the process environment or an --env-file.

# pysoem = a real bus through PySOEM; mock = ethercat-mock-slave (simulated)
ETHERCAT_BACKEND=pysoem
ETHERCAT_INTERFACE=eth0
# ETHERCAT_MOCK_HOST=127.0.0.1
# ETHERCAT_MOCK_PORT=6700

# Process-data cycle (us), state-change timeout (us)
# ETHERCAT_CYCLE_TIME=1000
# ETHERCAT_TIMEOUT=500000

# SLAVE_MAP_FILE=/absolute/path/to/slaves.json
# ETHERCAT_ESI_PATH=/absolute/path/to/esi
# ETHERCAT_ESI_MAX_MB=16

# Only from the environment or --env-file (ignored in ethercat-python/.env):
# ETHERCAT_WRITES_ENABLED=false
# ETHERCAT_STATE_CHANGE_ENABLED=false
# ETHERCAT_PD_WATCHDOG_MS=100
# ETHERCAT_EXPECTED_WKC=0
