# Example settings for ethercat-mcp. Copy to .env (connection settings only) or
# pass with --env-file PATH (any setting). `ethercat-mcp --help` lists them all.
#
# Safety switches (ETHERCAT_WRITES_ENABLED, ETHERCAT_STATE_CHANGE_ENABLED) are
# honoured only from the real process environment or an explicit --env-file.
# In a .env that the server finds by itself in its working directory they are
# ignored with a warning: when an MCP client starts the server, that directory
# is the client's project, which you may not control.

# pysoem = a real bus through PySOEM; mock = ethercat-mock-slave (simulated)
ETHERCAT_BACKEND=pysoem
ETHERCAT_INTERFACE=eth0
# ETHERCAT_MOCK_HOST=127.0.0.1
# ETHERCAT_MOCK_PORT=6700

# Process-data cycle (us), state-change timeout (us), watchdog (ms)
# ETHERCAT_CYCLE_TIME=1000
# ETHERCAT_TIMEOUT=500000
# ETHERCAT_PD_WATCHDOG_MS=100
# ETHERCAT_EXPECTED_WKC=0

# SLAVE_MAP_FILE=/absolute/path/to/slaves.json
# ETHERCAT_ESI_PATH=/absolute/path/to/esi

# Only from the environment or --env-file (ignored in an automatically found .env):
# ETHERCAT_WRITES_ENABLED=false
# ETHERCAT_STATE_CHANGE_ENABLED=false
