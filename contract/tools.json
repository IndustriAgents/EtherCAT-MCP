{
  "schemaVersion": 1,
  "protocol": "ethercat",
  "transport": "stdio",
  "tools": [
    {
      "name": "read_pdo",
      "description": "Select one target mode and provide only its parameters.\n\naddress: Read input process data (TxPDO) bytes of one slave from the cyclic process image.\n\n        Inputs only exist once the process image is mapped and are only valid while the\n        slave is in SAFEOP or OP (use set_slave_state first). Errors otherwise, and also\n        when the last frame's working counter shows that it was lost or (with every\n        process-data slave in SAFEOP/OP) that a slave did not process it. For a slave\n        with fewer than 8 input bits, only its own bits are returned, shifted to bit 0\n        (meta.bit_packed).\n\n        Args:\n            slave_position: 0-based position on the bus.\n            offset: First byte within the slave's input image (default 0).\n            length: Number of bytes (default: to the end of the slave's input image).\n        \n\nalias: Read input process data for an alias from SLAVE_MAP_FILE (same rules as read_pdo).\n\n        Args:\n            alias: Alias name from SLAVE_MAP_FILE.\n            length: Number of bytes. Default: the alias's length, else to the end of the input image.\n        ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slave_position": {
            "title": "Slave Position",
            "type": "integer",
            "description": "slave position for the selected operation; see its mode description."
          },
          "offset": {
            "default": 0,
            "title": "Offset",
            "type": "integer",
            "description": "offset for the selected operation; see its mode description."
          },
          "length": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Length",
            "description": "length for the selected operation; see its mode description."
          },
          "target": {
            "anyOf": [
              {
                "const": "address",
                "type": "string"
              },
              {
                "const": "alias",
                "type": "string"
              }
            ],
            "description": "Select the target mode described above."
          },
          "alias": {
            "title": "Alias",
            "type": "string",
            "description": "alias for the selected operation; see its mode description."
          }
        },
        "required": [
          "target"
        ],
        "oneOf": [
          {
            "properties": {
              "slave_position": {
                "title": "Slave Position",
                "type": "integer"
              },
              "offset": {
                "default": 0,
                "title": "Offset",
                "type": "integer"
              },
              "length": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Length"
              },
              "target": {
                "const": "address",
                "type": "string"
              }
            },
            "required": [
              "slave_position",
              "target"
            ],
            "type": "object",
            "additionalProperties": false
          },
          {
            "properties": {
              "alias": {
                "title": "Alias",
                "type": "string"
              },
              "length": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Length"
              },
              "target": {
                "const": "alias",
                "type": "string"
              }
            },
            "required": [
              "alias",
              "target"
            ],
            "type": "object",
            "additionalProperties": false
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "write_pdo",
      "description": "Select one target mode and provide only its parameters.\n\naddress: Write output process data (RxPDO) bytes of one slave into the cyclic process image.\n\n        Needs ETHERCAT_WRITES_ENABLED=true (off by default). The slave must be in OP,\n        because outputs are not applied in any other state. The bytes stay in the image\n        and go out with every cycle; the request is never repeated. success means they\n        went out and were confirmed: by the full expected working counter when every\n        process-data slave is in OP (meta.verified \"expected_wkc\"), otherwise by the\n        target still being in OP without error (meta.verified \"slave_state\"). If that\n        cannot be confirmed, meta.outcome is \"unknown\": read back before retrying.\n        Refused for slaves whose outputs are bit-packed into a byte shared with others.\n\n        Args:\n            slave_position: 0-based position on the bus.\n            offset: First byte within the slave's output image.\n            data: Byte values 0-255 to write starting at offset.\n        \n\nalias: Write output process data for an alias from SLAVE_MAP_FILE (same rules and gate as write_pdo).\n\n        Args:\n            alias: Alias name from SLAVE_MAP_FILE.\n            data: Byte values 0-255 to write at the alias's offset.\n        ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slave_position": {
            "title": "Slave Position",
            "type": "integer",
            "description": "slave position for the selected operation; see its mode description."
          },
          "offset": {
            "title": "Offset",
            "type": "integer",
            "description": "offset for the selected operation; see its mode description."
          },
          "data": {
            "items": {
              "type": "integer"
            },
            "title": "Data",
            "type": "array",
            "description": "data for the selected operation; see its mode description."
          },
          "target": {
            "anyOf": [
              {
                "const": "address",
                "type": "string"
              },
              {
                "const": "alias",
                "type": "string"
              }
            ],
            "description": "Select the target mode described above."
          },
          "alias": {
            "title": "Alias",
            "type": "string",
            "description": "alias for the selected operation; see its mode description."
          }
        },
        "required": [
          "target"
        ],
        "oneOf": [
          {
            "properties": {
              "slave_position": {
                "title": "Slave Position",
                "type": "integer"
              },
              "offset": {
                "title": "Offset",
                "type": "integer"
              },
              "data": {
                "items": {
                  "type": "integer"
                },
                "title": "Data",
                "type": "array"
              },
              "target": {
                "const": "address",
                "type": "string"
              }
            },
            "required": [
              "slave_position",
              "offset",
              "data",
              "target"
            ],
            "type": "object",
            "additionalProperties": false
          },
          {
            "properties": {
              "alias": {
                "title": "Alias",
                "type": "string"
              },
              "data": {
                "items": {
                  "type": "integer"
                },
                "title": "Data",
                "type": "array"
              },
              "target": {
                "const": "alias",
                "type": "string"
              }
            },
            "required": [
              "alias",
              "data",
              "target"
            ],
            "type": "object",
            "additionalProperties": false
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "scan_network",
      "description": "Enumerate the slaves on the bus (PySOEM config_init) and return their identity and state.\n\n        Not passive: SOEM resets every slave on the segment to INIT and then requests\n        PRE-OP while it enumerates. Before that, one broadcast read checks the segment:\n        if any slave is in SAFEOP or OP (another master may be running it), the scan is\n        refused unless both ETHERCAT_WRITES_ENABLED and ETHERCAT_STATE_CHANGE_ENABLED are\n        true. A rescan is always refused while a slave this server brought up is in\n        SAFEOP or OP.\n        Returns position, name, vendor ID, product code, revision, AL state and the\n        process-data sizes (null on a real bus until the process image is mapped);\n        meta.segment_state_before and meta.reset_live_segment say what the scan reset.\n        ",
      "inputSchema": {
        "properties": {},
        "title": "scan_networkArguments",
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_slave_info",
      "description": "Return one slave from the last scan, with its AL state read fresh from the bus.\n\n        Args:\n            slave_position: 0-based position on the bus, as reported by scan_network.\n        ",
      "inputSchema": {
        "properties": {
          "slave_position": {
            "title": "Slave Position",
            "type": "integer",
            "description": "slave position for the selected operation; see its mode description."
          }
