              }
            ],
            "default": null,
            "title": "Revision",
            "description": "revision for the selected operation; see its mode description."
          }
        },
        "required": [
          "filepath"
        ],
        "title": "load_esi_fileArguments",
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
