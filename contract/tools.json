    {
      "name": "set_slave_state",
      "description": "Request an AL state for one slave and wait until it is reached or ETHERCAT_TIMEOUT expires.\n\n        Needs both ETHERCAT_WRITES_ENABLED=true and ETHERCAT_STATE_CHANGE_ENABLED=true\n        (both off by default). On a real bus, the first request for SAFEOP or OP maps the\n        process image (zeroed) and starts the cyclic process-data exchange. A slave's\n        outputs are zeroed in the image before it enters OP and whenever it ends up\n        outside OP, so stale outputs are never re-applied. A pending AL error on the\n        slave is acknowledged. Follow the EtherCAT state machine: INIT -> PREOP ->\n        SAFEOP -> OP. success means the slave reports the requested state; a refusal is\n        meta.outcome \"rejected\", a timeout \"unknown\".\n\n        Args:\n            slave_position: 0-based position on the bus.\n            state: INIT, PREOP, SAFEOP or OP.\n        ",
      "inputSchema": {
        "properties": {
          "slave_position": {
            "title": "Slave Position",
            "type": "integer",
            "description": "slave position for the selected operation; see its mode description."
          },
          "state": {
            "title": "State",
            "type": "string",
            "description": "state for the selected operation; see its mode description."
          }
        },
        "required": [
          "slave_position",
          "state"
        ],
        "title": "set_slave_stateArguments",
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
