      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "test_slave_communication",
      "description": "Check that a slave answers: read its AL state, then try a CoE read of object 0x1000.\n\n        success is false if the slave does not answer the state read. A slave without\n        a mailbox (CoE) still passes; data.coe says whether the SDO read worked.\n\n        Args:\n            slave_position: 0-based position on the bus.\n        ",
      "inputSchema": {
        "properties": {
          "slave_position": {
            "title": "Slave Position",
            "type": "integer",
            "description": "slave position for the selected operation; see its mode description."
          }
        },
        "required": [
          "slave_position"
        ],
        "title": "test_slave_communicationArguments",
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "read_sdo",
      "description": "Read a CoE object (SDO upload) from a slave's object dictionary.\n\n        The slave must have a mailbox and be in PREOP, SAFEOP or OP.\n\n        Args:\n            slave_position: 0-based position on the bus.\n            index: Object index, e.g. \"0x1018\" (hex needs the 0x prefix; \"1018\" is decimal).\n            subindex: Subindex 0-255 (default 0).\n            data_type: How to decode the bytes: BOOL, INT8, UINT8, INT16, UINT16, INT32, UINT32,\n                INT64, UINT64, REAL32, REAL64, STRING or BYTES (IEC names such as UDINT also work).\n                Without it, 1/2/4/8-byte values are decoded as unsigned integers.\n        ",
      "inputSchema": {
        "properties": {
          "slave_position": {
            "title": "Slave Position",
            "type": "integer",
            "description": "slave position for the selected operation; see its mode description."
          },
          "index": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Index",
            "description": "index for the selected operation; see its mode description."
          },
          "subindex": {
            "default": 0,
            "title": "Subindex",
            "type": "integer",
            "description": "subindex for the selected operation; see its mode description."
          },
          "data_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Data Type",
            "description": "data type for the selected operation; see its mode description."
          }
        },
        "required": [
          "slave_position",
          "index"
        ],
        "title": "read_sdoArguments",
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "write_sdo",
      "description": "Write a CoE object (SDO download) in a slave's object dictionary.\n\n        Needs ETHERCAT_WRITES_ENABLED=true (off by default). success means the slave\n        acknowledged the download. The download is never repeated: if the answer is\n        lost, meta.outcome is \"unknown\" (read back before retrying); an SDO abort is\n        \"rejected\".\n\n        Args:\n            slave_position: 0-based position on the bus.\n            index: Object index, e.g. \"0x8000\".\n            subindex: Subindex 0-255.\n            value: The value to write. A number, true/false, a string, or a list of byte values.\n            data_type: Encoding of value: BOOL, INT8, UINT8, INT16, UINT16, INT32, UINT32, INT64,\n                UINT64, REAL32, REAL64, STRING or BYTES. Required unless value is a list of bytes.\n        ",
      "inputSchema": {
        "properties": {
          "slave_position": {
            "title": "Slave Position",
            "type": "integer",
            "description": "slave position for the selected operation; see its mode description."
          },
          "index": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Index",
            "description": "index for the selected operation; see its mode description."
          },
          "subindex": {
            "title": "Subindex",
            "type": "integer",
            "description": "subindex for the selected operation; see its mode description."
          },
          "value": {
            "title": "Value",
            "description": "value for the selected operation; see its mode description."
          },
          "data_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Data Type",
            "description": "data type for the selected operation; see its mode description."
          }
        },
        "required": [
          "slave_position",
          "index",
          "subindex",
          "value"
        ],
        "title": "write_sdoArguments",
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": "object"
          }
        },
        "additionalProperties": false
