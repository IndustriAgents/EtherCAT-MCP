    {
      "name": "load_esi_file",
      "description": "Parse an ESI (EtherCAT Slave Information) XML file (no bus access).\n\n        Returns the vendor and, for a single matching device, its object dictionary\n        (index, name, type, subindexes) and Tx/Rx PDO mappings. When several devices\n        match, returns a summary list instead.\n\n        Args:\n            filepath: Path to the file, or a file name inside ETHERCAT_ESI_PATH.\n            device_type: Device type to pick, e.g. \"EL1008\".\n            revision: Revision to pick, e.g. \"0x00120000\".\n        ",
      "inputSchema": {
        "properties": {
          "filepath": {
            "title": "Filepath",
            "type": "string",
            "description": "filepath for the selected operation; see its mode description."
          },
          "device_type": {
